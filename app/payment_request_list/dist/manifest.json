{
	"_version": "1.90.0",
	"sap.app": {
		"id": "com.fiori.paymentrequestlist",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.34.0",
			"toolsId": "580ef3c9-9218-4ae8-a493-32abe4696d37"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/payment-request/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.154.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.fiori.paymentrequestlist.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "PaymentRequestsList",
					"target": "PaymentRequestsList"
				},
				{
					"pattern": "PaymentRequests({key}):?query:",
					"name": "PaymentRequestsObjectPage",
					"target": "PaymentRequestsObjectPage"
				}
			],
			"targets": {
				"PaymentRequestsList": {
					"type": "Component",
					"id": "PaymentRequestsList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/PaymentRequests",
							"variantManagement": "Page",
							"navigation": {
								"PaymentRequests": {
									"detail": {
										"route": "PaymentRequestsObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				},
				"PaymentRequestsObjectPage": {
					"type": "Component",
					"id": "PaymentRequestsObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/PaymentRequests",
							"controlConfiguration": {
								"attachments/@com.sap.vocabularies.UI.v1.LineItem": {
									"columns": {
										"DataField::note": {
											"formatOptions": {
												"textLinesEdit": 2,
												"textMaxLines": 2
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"extends": {
			"extensions": {
				"sap.ui.controllerExtensions": {
					"sap.fe.templates.ObjectPage.ObjectPageController#com.fiori.paymentrequestlist::PaymentRequestsObjectPage": {
						"controllerName": "com.fiori.paymentrequestlist.ext.controller.ObjectPageExt"
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "agmc.pay.req.mgmt.approuter"
	}
}