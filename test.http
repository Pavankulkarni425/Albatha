##############################################################################################
# Full cycle of ONE payment request (VS Code REST Client — run the steps top to bottom)
#
#   CPI creates request  → DOC_PENDING
#   user uploads docs    → NEW
#   user starts workflow → IN_APPROVAL
#   BPA level 1 approves → IN_APPROVAL
#   BPA level 2 approves → APPROVED
#   CPI: sent to bank    → SENT_TO_BANK
#   CPI: bank confirms   → SETTLED
#
# IDs are taken from earlier responses (# @name), nothing to copy by hand.
# requestId must be unique: change it before running the cycle again on the same database.
##############################################################################################

@server = http://localhost:4004
@app    = {{server}}/odata/v4/payment-request
@int    = {{server}}/integration

### 1. CPI → CAP: create the payment request (status → DOC_PENDING, BTP reference generated)
# @name create
POST {{int}}/PaymentRequests
Content-Type: application/json

{
  "requestId": "PR-2026-0458",
  "paymentType_code": "VENDOR_PAYMENT",
  "vendorCode": "V1007",
  "vendorName": "Al Futtaim Engineering LLC",
  "paymentAmount": 47250.00,
  "currency_code": "AED",
  "paymentDueDate": "2026-11-30",
  "companyCode": "1000",
  "costCentre": "CC300",
  "glAccount": "410300",
  "paymentMethod_code": "TT",
  "bankName": "Emirates NBD",
  "iban": "AE070260001015678901234",
  "bankAccountNo": "1015678901234",
  "swiftCode": "EBILAEAD",
  "requestorName": "Rahul Menon",
  "requestorEmpId": "E1003",
  "requestCreatedAt": "2026-11-04T07:45:00Z",
  "items": [
    { "invoiceNumber": "AFE/INV/2026/1182", "invoiceDate": "2026-10-18", "invoiceAmount": 31500.00, "currency_code": "AED" },
    { "invoiceNumber": "AFE/INV/2026/1207", "invoiceDate": "2026-10-27", "invoiceAmount": 15750.00, "currency_code": "AED" }
  ]
}

###
@ID  = {{create.response.body.ID}}
@REF = {{create.response.body.btpPaymentRef}}
@active = {{app}}/PaymentRequests(ID={{ID}},IsActiveEntity=true)
@draft  = {{app}}/PaymentRequests(ID={{ID}},IsActiveEntity=false)

### 2. Document checklist → INVOICE, PO, GRN are Mandatory / Pending
GET {{active}}/checklist?$select=docType_code,level,status


### 3. Fiori user: Edit (opens a draft)
POST {{active}}/PaymentRequestService.draftEdit
Content-Type: application/json

{ "PreserveChanges": true }

### 4a. Upload Tax Invoice — metadata
# @name inv
POST {{draft}}/attachments
Content-Type: application/json

{ "filename": "AFE-INV-2026-1182.pdf", "mimeType": "application/pdf", "docType_code": "INVOICE" }

### 4b. Upload Tax Invoice — file content
PUT {{draft}}/attachments(up__ID={{ID}},ID={{inv.response.body.ID}},IsActiveEntity=false)/content
Content-Type: application/pdf

< ./test/sample.pdf

### 5a. Upload Purchase Order — metadata
# @name po
POST {{draft}}/attachments
Content-Type: application/json

{ "filename": "PO-4500098812.pdf", "mimeType": "application/pdf", "docType_code": "PO" }

### 5b. Upload Purchase Order — file content
PUT {{draft}}/attachments(up__ID={{ID}},ID={{po.response.body.ID}},IsActiveEntity=false)/content
Content-Type: application/pdf

< ./test/sample.pdf

### 6a. Upload Goods Receipt — metadata
# @name grn
POST {{draft}}/attachments
Content-Type: application/json

{ "filename": "GRN-5000041177.pdf", "mimeType": "application/pdf", "docType_code": "GRN" }

### 6b. Upload Goods Receipt — file content
PUT {{draft}}/attachments(up__ID={{ID}},ID={{grn.response.body.ID}},IsActiveEntity=false)/content
Content-Type: application/pdf

< ./test/sample.pdf

### 7. Fiori user: Save (status → NEW, all mandatory documents present)
POST {{draft}}/PaymentRequestService.draftActivate
Content-Type: application/json

{}

### 8. Fiori user: Start Workflow (CAP → BPA; status → IN_APPROVAL, bpaWorkflowInstanceId filled)
POST {{active}}/PaymentRequestService.startWorkflow
Content-Type: application/json

{}

### 9. BPA → CAP: documents shown to the approver
POST {{int}}/getAttachedDocuments
Content-Type: application/json

{ "btpPaymentRef": "{{REF}}" }

### 10. BPA → CAP: Level 1 approved (status stays IN_APPROVAL)
POST {{int}}/updateWorkflowStatus
Content-Type: application/json

{
  "btpPaymentRef": "{{REF}}",
  "stepNo": 1,
  "stepName": "Finance Manager Approval",
  "approverId": "finance.manager@agmc.com",
  "approverName": "Khalid Al Mansoori",
  "decision": "Approved",
  "comments": "Invoices match PO 4500098812 and GRN 5000041177. OK to proceed.",
  "bpaTaskId": "7f3c2a10-1b4e-4c8a-9d21-5e6f7a8b9c01",
  "isFinalStep": false
}

### 11.1. BPA → CAP: Level 2 (final) approved (status → APPROVED)
POST {{int}}/updateWorkflowStatus
Content-Type: application/json

{
  "btpPaymentRef": "{{REF}}",
  "stepNo": 2,
  "stepName": "Finance Head Approval",
  "approverId": "finance.head@agmc.com",
  "approverName": "Priya Nair",
  "decision": "Sent Back",
  "comments": "Returned for payment run on 2026-11-28.",
  "bpaTaskId": "8a4d3b21-2c5f-4d9b-8e32-6f7a8b9c0p03",
  "isFinalStep": false
}

### 11.2. BPA → CAP: Level 2 (final) approved (status → APPROVED)
POST {{int}}/updateWorkflowStatus
Content-Type: application/json

{
  "btpPaymentRef": "{{REF}}",
  "stepNo": 2,
  "stepName": "Finance Head Approval",
  "approverId": "finance.head@agmc.com",
  "approverName": "Priya Nair",
  "decision": "Approved",
  "comments": "Approved for payment run on 2026-11-28.",
  "bpaTaskId": "8a4d3b21-2c5f-4d9b-8e32-6f7a8b9c0d12",
  "isFinalStep": true
}

### 12. CPI → CAP: payment sent to the bank (status → SENT_TO_BANK)
POST {{int}}/updatePaymentStatus
Content-Type: application/json

{
  "btpPaymentRef": "{{REF}}",
  "status": "SENT_TO_BANK",
  "bankPaymentRef": "ENBD-TT-20261128-004517",
  "statusDate": "2026-11-28"
}

### 13. CPI → CAP: bank confirms value date (status → SETTLED)
POST {{int}}/updatePaymentStatus
Content-Type: application/json

{
  "btpPaymentRef": "{{REF}}",
  "status": "SETTLED",
  "bankPaymentRef": "ENBD-TT-20261128-004517",
  "statusDate": "2026-11-30"
}

### 14. Final check: status, bank data, approval history, attachments
GET {{active}}?$select=btpPaymentRef,requestId,status_code,approvalLevel,bpaWorkflowInstanceId,bankPaymentRef,sentToBankAt,settledOn&$expand=items,approvalHistory($select=stepNo,stepName,approverName,decision,comments,decisionAt),attachments($select=filename,docType_code)
